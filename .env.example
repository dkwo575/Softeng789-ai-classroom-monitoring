POSTGRES_DB=classroom_monitoring
POSTGRES_USER=classroom_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/classroom_monitoring
SERVER_PORT=8080
# Browser requests use /api on the frontend origin (Vite proxies locally).
# Legacy VITE_API_BASE_URL values are no longer used.
# Production only: one HTTPS origin without a path/trailing slash; not selected yet.
PUBLIC_APP_ORIGIN=

# Used once to activate the passwordless administrator created by database/schema.sql.
# Leave blank after the first successful startup, or when using database/demo_data.sql.
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login brute-force protection. Spring duration syntax accepts values such as 30s, 15m or 1h.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW=15m
AUTH_LOGIN_BLOCK_DURATION=15m
# Disabled means activation/recovery requests return an explicit unavailable state, never fake success.
# Do not enable SMTP until a provider, sender and designated test recipient are authorized.
ACCOUNT_EMAIL_PROVIDER=disabled
ACCOUNT_EMAIL_FROM=

# Only bank transfer/cash are offered by default; submission still requires staff approval.
# Local demo checkout additionally requires the payment-demo Spring profile. Never enable it in production.
PAYMENT_CHECKOUT_MODE=MANUAL

# Demo keeps delivery inside the app. Set to smtp and provide Spring mail settings to send email.
REPORT_EMAIL_PROVIDER=demo
REPORT_EMAIL_FROM=no-reply@classroomiq.local
FEEDBACK_SUMMARY_PROVIDER=demo
PAYMENT_MESSAGE_PROVIDER=demo
INVOICE_EMAIL_PROVIDER=demo
INVOICE_EMAIL_FROM=no-reply@classlens.local
# Set to http after the FastAPI adapter and private Qwen server are running.
# Qwen report generation can take longer than the computer-vision endpoints.
FEEDBACK_SUMMARY_READ_TIMEOUT=90s

# Legacy opt-in enrollment adapter. Account registration no longer requires face captures.
# New supervised photo attendance uses the separate CV settings below.
FACE_ENROLLMENT_PROVIDER=http
AI_SERVICE_URL=http://127.0.0.1:8000
# Required by inbound AI event endpoints. Use a long random value shared only with the lab service.
AI_INGEST_KEY=
# Shared Spring -> FastAPI credential. Generate a private random value; never expose it in the browser.
AI_ADAPTER_KEY=

# Optional adult-volunteer photo-attendance pilot. Apply the CV SQL migration before starting
# the updated backend, even when this flag is false. See docs/phase1-photo-attendance.md.
CV_ENABLED=false
# Voluntary adult webcam event-sharing pilot. Independent of photo attendance.
# Review docs/phase3b-webcam-sharing.md before enabling; defaults off.
WEBCAM_SHARING_ENABLED=false
# Single-server, four-student WebRTC video pilot. See docs/phase3c-live-video.md.
LIVE_VIDEO_ENABLED=false
CV_SERVICE_URL=http://127.0.0.1:8000
# Shared by Spring and private FastAPI only; at least 32 random characters.
CV_SERVICE_KEY=
# Spring only: base64-encoded 32 random bytes for AES-256-GCM. Never use a VITE_ prefix.
CV_ENCRYPTION_KEY=
# FastAPI only; relative to ai-service when launched there.
CV_MODEL_DIR=../models
CV_MATCH_THRESHOLD=0.5
CV_MATCH_MARGIN=0.08

# Private report-summary inference. Use ollama/lmstudio locally or vllm in production.
LLM_RUNTIME=vllm
LLM_BASE_URL=http://127.0.0.1:8001
LLM_API_KEY=replace_with_a_private_inference_key
LLM_MODEL=Qwen/Qwen3-30B-A3B
LLM_TIMEOUT_SECONDS=90

# Production vLLM deployment tuning. These do not leak into application business logic.
VLLM_IMAGE=vllm/vllm-openai:v0.8.5
VLLM_PORT=8001
QWEN_MAX_MODEL_LEN=16384
QWEN_GPU_MEMORY_UTILIZATION=0.90
QWEN_TENSOR_PARALLEL_SIZE=1

# Private local storage for student cash and bank-transfer receipts. Do not expose this directory directly.
PAYMENT_EVIDENCE_DIR=../data/payment-evidence
